<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.AfficherRecetteDetailActivity">

    <Button
        android:id="@+id/btnAjouteRecetteDetail"
        android:layout_width="61dp"
        android:layout_height="56dp"
        android:background="@drawable/bouton_arrondi"
        android:text="@string/bouton_signe_plus"
        android:textColor="@color/blanc"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/etRechercheRecetteDetail"
        app:layout_constraintTop_toTopOf="@+id/etRechercheRecetteDetail" />

    <ImageView
        android:id="@+id/imgVLogoRecetteDetail"
        android:layout_width="144dp"
        android:layout_height="98dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.471"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <EditText
        android:id="@+id/etRechercheRecetteDetail"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="90dp"
        android:background="@drawable/fond_champ_recherche"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:hint="@string/barre_recherche_indice"
        android:imeOptions="actionSearch"
        android:singleLine="true"
        android:inputType="text"
        android:padding="12dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColorHint="#999999"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgVLogoRecetteDetail" />

    <TextView
        android:id="@+id/tvIngredientsRecetteDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="15dp"
        android:text="@string/textview_ingredients_recetteDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNomRecetteDetail" />

    <TextView
        android:id="@+id/tvEtapesRecetteDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="10dp"
        android:text="@string/textview_Etapes_recetteDetail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollVRecetteDetail" />

    <TextView
        android:id="@+id/tvNomRecetteDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="75dp"
        android:layout_marginEnd="75dp"
        android:background="@drawable/bouton_arrondi"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgVPhotoRecetteDetail"
        tools:text="Pizza sans fromage" />

    <ScrollView
        android:id="@+id/scrollVRecetteDetail"
        android:layout_width="348dp"
        android:layout_height="92dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvIngredientsRecetteDetail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIngredientsActuelRecetteDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fond_champ_recherche"
                android:padding="12dp"
                tools:text="TextView" />
        </LinearLayout>
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEtapesRecetteDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="30dp"
        app:layoutManager="LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEtapesRecetteDetail"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/imgVPhotoRecetteDetail"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvCategorieRecetteDetail"
        app:srcCompat="@drawable/imgdefaut_recette" />

    <TextView
        android:id="@+id/tvCategorieRecetteDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:text="@string/textview_categorie_RecetteDetail"
        android:textColor="#AAAAAA"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etRechercheRecetteDetail" />

    <TextView
        android:id="@+id/tvNomCategorieRecetteDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FEA95B"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/tvCategorieRecetteDetail"
        app:layout_constraintStart_toEndOf="@+id/tvCategorieRecetteDetail"
        tools:text="Pizza" />

    <Button
        android:id="@+id/btnEditerCategorie"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/edit_icone"
        app:layout_constraintStart_toEndOf="@+id/imgVPhotoRecetteDetail"
        app:layout_constraintTop_toTopOf="@+id/imgVPhotoRecetteDetail" />

    <Button
        android:id="@+id/btnSupprimerCategorie"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/delete_icone"
        app:layout_constraintStart_toStartOf="@+id/btnEditerCategorie"
        app:layout_constraintTop_toBottomOf="@+id/btnEditerCategorie" />

</androidx.constraintlayout.widget.ConstraintLayout>