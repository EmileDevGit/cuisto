<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_intro">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="484dp"
        android:layout_height="313dp"
        android:contentDescription="@string/logo"
        android:src="@drawable/logo_cuisto"
        app:layout_constraintBottom_toTopOf="@id/bouton_decouvrir"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.506"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.188" />

    <Button
        android:id="@+id/bouton_decouvrir"
        android:layout_width="249dp"
        android:layout_height="60dp"
        android:background="@drawable/bouton_arrondi"
        android:fontFamily="sans-serif-medium"
        android:text="@string/bouton_intro_explorer"
        android:textAllCaps="false"
        android:textColor="@color/blanc"
        android:textSize="20sp"
        android:textStyle="bold"
        android:theme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.561"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.701" />

</androidx.constraintlayout.widget.ConstraintLayout>