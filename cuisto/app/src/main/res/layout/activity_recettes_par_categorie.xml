<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@android:color/white">

    <!-- Zone fixe en haut -->
    <LinearLayout
        android:id="@+id/zone_haut"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logo_cuisto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/logo_cuisto"
            android:contentDescription="Logo Cuisto" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/champ_recherche"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/fond_champ_recherche"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:hint="@string/barre_recherche_indice"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:padding="12dp"
                android:textColorHint="#999999"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_ajouter"
                android:layout_width="66dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bouton_arrondi"
                android:text="@string/bouton_signe_plus"
                android:textColor="@android:color/white"
                android:textSize="24sp" />
        </LinearLayout>

        <Button
            android:id="@+id/texte_categorie"
            android:layout_width="190dp"
            android:layout_height="48dp"
            tools:text="CATEGORIE /"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:layout_marginTop="30dp"
            android:background="@drawable/bouton_arrondi_pas_cliquable"
            android:layout_gravity="center_horizontal" />
    </LinearLayout>

    <!-- Scroll uniquement sur les recettes -->
    <ScrollView
        android:id="@+id/scroll_recettes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/zone_haut"
        app:layout_constraintBottom_toTopOf="@id/barre_categories"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="16dp">

            <!-- 1 blec de recette par categorie -->

            <HorizontalScrollView
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/zone_dynamique_recettes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- Plats -->
                    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
                        android:layout_width="400dp"
                        android:layout_height="380dp"
                        android:layout_gravity="center"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:id="@+id/image_recette"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/titre_recette"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            tools:text="Titre"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

<!--            ************** Mise en place du GIF SWIPE ***************-->
            <ImageView
                android:id="@+id/gif_cuisto"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:layout_gravity="center_horizontal"
                app:layout_constraintTop_toBottomOf="@id/scroll_recettes"
                app:layout_constraintBottom_toTopOf="@id/barre_categories"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </LinearLayout>
    </ScrollView>



    <!-- Barre des catégories -->
    <HorizontalScrollView
        android:id="@+id/barre_categories"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:scrollbars="none"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/zone_dynamique_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        </LinearLayout>

    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
