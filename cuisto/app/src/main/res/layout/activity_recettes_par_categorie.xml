<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Zone fixe en haut -->
    <LinearLayout
        android:id="@+id/zone_haut"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logo_cuisto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/logo_cuisto"
            android:contentDescription="Logo Cuisto" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/champ_recherche"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/fond_champ_recherche"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:hint="Recherche une recette ..."
                android:padding="12dp"
                android:textColorHint="#999999"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_ajouter"
                android:layout_width="66dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bouton_arrondi"
                android:text="+"
                android:textColor="@android:color/white"
                android:textSize="24sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_recettes"
            android:layout_width="190dp"
            android:layout_height="48dp"
            android:text="Pizza 😋"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:layout_marginTop="40dp"
            android:background="@drawable/bouton_arrondi_pas_cliquable"
            android:layout_gravity="center_horizontal" />
    </LinearLayout>

    <!-- Scroll uniquement sur les recettes -->
    <ScrollView
        android:id="@+id/scroll_recettes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/zone_haut"
        app:layout_constraintBottom_toTopOf="@id/barre_categories"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="-20dp"
            android:padding="16dp">

            <!-- 1 blec de recette par categorie -->
            <TextView
                android:id="@+id/texte_categorie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORIE / Pizza"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- Plat 1 -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/pizzachevremiel" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            android:text="Pizza chèvre miel"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <!-- Plat 2 -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/burgersteakfromage" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            android:text="Burger steak fromage"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>
                    <!-- Plat 3 -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/burgersteakfromage" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            android:text="Burger steak fromage"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>
                    <!-- Plat 4 -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/burgersteakfromage" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            android:text="Burger steak fromage"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- 2eme blec de recette par categorie -->

            <TextView
                android:id="@+id/texte_categorie2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CATEGORIE / Pizza"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- Plat 1 -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/pizzachevremiel" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            android:text="Pizza chèvre miel"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <!-- Plat 2 -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/burgersteakfromage" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            android:text="Burger steak fromage"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>
                    <!-- Plat 3 -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/burgersteakfromage" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            android:text="Burger steak fromage"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>
                    <!-- Plat 4 -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="16dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/burgersteakfromage" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="#AA000000"
                            android:text="Burger steak fromage"
                            android:textColor="@android:color/white"
                            android:padding="8dp"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </FrameLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Barre des catégories -->
    <HorizontalScrollView
        android:id="@+id/barre_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:scrollbars="none"
        android:fillViewport="true"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Catégorie : Pizza -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/cat_pizza"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icone_pizza_cat" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pizza"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Catégorie : Salade -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/cat_salade"
                    android:layout_width="76dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icone_salade_cat" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salade"
                    android:textSize="12sp" />
            </LinearLayout>
            <!-- Catégorie : Tacos -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/cat_tacos"
                    android:layout_width="74dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icone_tacos_cat" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tacos"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Catégorie : Gateau -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/cat_gateau"
                    android:layout_width="78dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icone_gateau_cat" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gateau"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Catégorie : Burger -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/cat_burger"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icone_burger_cat" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Burger"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Catégorie : Pâtes -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/cat_pates"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icone_pates_cat" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pâtes"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
